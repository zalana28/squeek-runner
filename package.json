{
  "name": "squeek-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Squeek Runner — WHEELY9000 Arcade. Lane-crossing arcade whose pace comes from a real hamster's settled work on Squeekchain (Sepolia).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run sync-record",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "sync-record": "tsx scripts/sync-record.ts",
    "verify": "tsx scripts/verify-cli.ts",
    "compare-hud": "tsx scripts/compare-hud.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  }
}
